@using raresmac.github.io.Models
@using MudBlazor

<MudDialog Class="dialog-glass-container">
    <DialogContent>
        <div class="project-detail-layout">
            <MudIconButton Icon="@Icons.Material.Filled.Close" Class="close-fab" OnClick="Cancel" />

            <div class="image-header-container">
                <div class="image-background-blur" style="background-image: url('@Project.ImageUrl')"></div>

                @if (!string.IsNullOrEmpty(Project.VideoId))
                {
                    <iframe class="header-video" src="https://www.youtube.com/embed/@Project.VideoId?autoplay=1&mute=1" title="YouTube video player" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe>
                }
                else
                {
                    <img src="@Project.ImageUrl" alt="@Project.Title" class="header-img-responsive" />
                }
            </div>

            <div class="content-body pa-8">
                <MudText Typo="Typo.h3" Class="fw-900 mb-2 gradient-text">@Project.Title</MudText>

                <div class="d-flex flex-wrap gap-2 mb-6">
                    @foreach (var tag in Project.Tags)
                    {
                        <span class="tag-pill">@tag</span>
                    }
                </div>

                <MudDivider Class="mb-6 opacity-10" />

                <MudText Typo="Typo.body1" Class="description-text">@Project.Description</MudText>

                <div class="mt-10 d-flex flex-wrap gap-4">
                    @if (!string.IsNullOrEmpty(Project.GithubUrl))
                    {
                        <MudButton StartIcon="@Icons.Custom.Brands.GitHub" Variant="Variant.Filled" Color="Color.Primary" Href="@Project.GithubUrl" Target="_blank" Class="rounded-pill px-8 py-3">View Source</MudButton>
                    }
                    @if (!string.IsNullOrEmpty(Project.ExternalUrl))
                    {
                        <MudButton StartIcon="@Icons.Material.Filled.Language" Variant="Variant.Outlined" Color="Color.Primary" Href="@Project.ExternalUrl" Target="_blank" Class="rounded-pill px-8 py-3">Visit Project</MudButton>
                    }
                </div>
            </div>
        </div>
    </DialogContent>
</MudDialog>

<style>
    .dialog-glass-container {
        background: rgba(10,10,10,0.96) !important;
        backdrop-filter: blur(25px);
        border-radius: 24px !important;
        border: 1px solid rgba(255,255,255,0.1) !important;
        overflow: hidden;
        max-width: 1000px !important;
    }

    .project-detail-layout {
        position: relative;
        max-height: 90vh;
        overflow-y: auto;
    }

    .close-fab {
        position: absolute;
        top: 1.5rem;
        right: 1.5rem;
        z-index: 100;
        background: rgba(0,0,0,0.6) !important;
        color: white !important;
    }

    .image-header-container {
        width: 100%;
        height: 450px;
        background: #000;
        position: relative;
        display: flex;
        justify-content: center;
        align-items: center;
        overflow: hidden;
    }

    .image-background-blur {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background-size: cover;
        background-position: center;
        filter: blur(50px) brightness(0.4);
        transform: scale(1.1);
        z-index: 1;
    }

    .header-img-responsive {
        max-width: 100%;
        max-height: 100%;
        width: auto;
        height: auto;
        display: block;
        position: relative;
        z-index: 2;
        box-shadow: 0 0 40px rgba(0,0,0,0.8);
    }

    .header-video {
        width: 100%;
        height: 100%;
        position: relative;
        z-index: 2;
    }

    .gradient-text {
        background: linear-gradient(90deg, #00E5FF, #7000FF);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .fw-900 {
        font-weight: 900;
    }

    .description-text {
        color: #D0D0D0;
        line-height: 1.8;
        font-size: 1.1rem;
    }

    .tag-pill {
        background: rgba(0, 229, 255, 0.1);
        color: #00E5FF;
        padding: 4px 12px;
        border-radius: 20px;
        font-size: 0.8rem;
        border: 1px solid rgba(0, 229, 255, 0.2);
    }

    .opacity-10 {
        opacity: 0.1;
    }

    @@media (max-width: 600px) {
        .image-header-container {
            height: 300px;
        }
    }
</style>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public Project Project { get; set; } = new();
    void Cancel() => MudDialog.Cancel();
}